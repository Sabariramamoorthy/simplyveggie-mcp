PUBLIC_ORIGIN=https://simplyveggie-mcp.example.com
# Random secret, 32+ characters. MCP clients send it as `Authorization: Bearer <MCP_TOKEN>`.
MCP_TOKEN=GENERATE_A_RANDOM_32_BYTE_SECRET
# Random secret, 32+ characters. Entered once on the consent page when ChatGPT or Claude
# connects through OAuth. Leave empty to disable OAuth (MCP_TOKEN still works).
OWNER_KEY=GENERATE_A_DIFFERENT_RANDOM_32_BYTE_SECRET
# The Simply Veggie account (phone + password, as used on simplyveggie.co.in).
SIMPLYVEGGIE_PHONE=YOUR_10_DIGIT_MOBILE
SIMPLYVEGGIE_PASSWORD=
DATA_DIR=./data
# Defaults: 127.0.0.1 and 9320. Containers set HOST=0.0.0.0.
HOST=127.0.0.1
PORT=9320
